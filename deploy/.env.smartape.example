APP_NAME="Qreaget"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://qreaget.am
FORCE_HTTPS=true

APP_LOCALE=hy
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=single
LOG_LEVEL=error

# MySQL from the SmartApe control panel (Базы данных → MySQL)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

INSTALL_KEY=
ADMIN_EMAIL=admin@qreaget.am
ADMIN_PASSWORD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
